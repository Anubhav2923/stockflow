# Application Configuration
NODE_ENV=development
PORT=5000
APP_NAME=StockFlow

# Frontend
CORS_ORIGIN=http://localhost:5173

# logging
LOG_LEVEL=debug

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Request configuration
REQUEST_BODY_LIMIT=100kb
TRUST_PROXY=0

# server configuration
SHUTDOWN_TIMEOUT_MS=10000
# Local PostgreSQL (Docker Compose)
DATABASE_URL=postgresql://stockflow:stockflow_local@127.0.0.1:5433/stockflow
DIRECT_URL=postgresql://stockflow:stockflow_local@127.0.0.1:5433/stockflow

# Development seed account
SEED_USERNAME=stockflow
SEED_PASSWORD=stockflow_local_demo
